# Copy to .env and fill in. Never commit .env.

# Your VM's public IP with dashes + .sslip.io gives a free hostname Caddy can get HTTPS for,
# e.g. 129.146.10.20 → 129-146-10-20.sslip.io
DOMAIN=129-146-10-20.sslip.io
PUBLIC_URL=https://129-146-10-20.sslip.io

# Same random value as WORKER_SECRET on Render (make one: openssl rand -hex 32)
WORKER_SECRET=
SERVER_URL=https://brainvault-app.onrender.com

# Copy these three from Render's environment so the worker can send the "clips ready" push itself
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Whisper: small is the sweet spot on a 2-core server (medium is better but ~2.5x slower).
# Set WHISPER_THREADS to the server's core count.
WHISPER_MODEL=small
WHISPER_THREADS=2
KEEP_DAYS=14

# Optional: Cloudflare R2 instead of serving clips from this VM
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE=https://pub-xxxx.r2.dev
