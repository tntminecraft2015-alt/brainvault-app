    "thread-1792527554176-1-streak-momentum-grid-with-visual-consist": {
      "id": "thread-1792527554176-1-streak-momentum-grid-with-visual-consist",
      "title": "Streak Momentum Grid with Visual Consistency Heatmap",
      "description": "Habit tracker apps use bento grids of tappable tiles with oversized streak numerals and GitHub-style momentum grids that turn progress into a glowing mosaic. Mission Control already shows a day streak counter but could surface a year-long heatmap in the Home card or a dedicated Streaks modal—color-coded by completion rate (full week = bright accent, partial = medium tint, empty = darker). This visualizes consistency over time without requiring new data, only a visual reframe of what the app already tracks.",
      "source_title": "Streakly — Habit Tracker App UI",
      "source_url": "https://sleek.design/templates/habit-tracker-app",
      "mockup_html": "<style>*{margin:0;padding:0;box-sizing:border-box}.mockup{background:#0a1929;color:#dfeeff;font-family:VT323,monospace;padding:40px}.streak-header{font-size:11px;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;color:#ff8a63}.current-streak{background:#1e3a5f;border:2px solid #ff8a63;padding:16px;border-radius:2px;margin-bottom:20px;text-align:center}.streak-num{font-size:28px;font-weight:bold;color:#ff8a63;display:block}.streak-label{font-size:10px;color:#dfeeff;margin-top:4px}.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:16px}.cell{width:24px;height:24px;border-radius:1px;border:1px solid rgba(255,138,99,0.3);transition:all 0.2s}.cell.empty{background:#12253c}.cell.partial{background:rgba(255,138,99,0.4)}.cell.full{background:#ff8a63;border-color:#ff8a63}.row-label{font-size:8px;color:#ff8a63;text-transform:uppercase;margin-bottom:4px}.week{margin-bottom:8px}</style><div class=\"mockup\"><div class=\"streak-header\">WEEK CONSISTENCY</div><div class=\"current-streak\"><span class=\"streak-num\">12</span><span class=\"streak-label\">days active</span></div><div class=\"week\"><div class=\"row-label\">OCT '26</div><div class=\"grid\"><div class=\"cell full\"></div><div class=\"cell full\"></div><div class=\"cell full\"></div><div class=\"cell partial\"></div><div class=\"cell empty\"></div><div class=\"cell full\"></div><div class=\"cell full\"></div></div></div><div class=\"week\"><div class=\"row-label\">SEP '26</div><div class=\"grid\"><div class=\"cell full\"></div><div class=\"cell full\"></div><div class=\"cell empty\"></div><div class=\"cell partial\"></div><div class=\"cell full\"></div><div class=\"cell full\"></div><div class=\"cell empty\"></div></div></div></div>",
